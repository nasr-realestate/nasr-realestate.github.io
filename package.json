{
  "name": "semsar-talabk",
  "version": "1.0.0",
  "description": "سمسار طلبك — خبير عقارات مدينة نصر",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Build completed')\"",
    "lint": "node --check server.js",
    "build:ai": "node scripts/build-ai-artifacts.mjs",
    "build:ai:check": "node scripts/build-ai-artifacts.mjs --check",
    "test": "node --test _worker/tests/*.test.mjs scripts/tests/*.test.mjs",
    "facets": "node scripts/build-listing-facets.mjs",
    "check:site": "node scripts/check-built-site.mjs _site",
    "test:ai": "node --test _worker/tests/ai-artifacts.test.mjs _worker/tests/mcp-gateway.test.mjs scripts/tests/front-matter.test.mjs",
    "build:site": "node scripts/build-ai-artifacts.mjs --out=_site",
    "lint:sonar": "eslint .",
    "css": "node scripts/build-css.mjs",
    "images": "node scripts/images/build-image-variants.mjs",
    "css:check": "node scripts/build-css.mjs --check",
    "fonts": "node scripts/fonts/build-cairo.mjs",
    "fonts:check": "node scripts/fonts/build-cairo.mjs --check"
  },
  "dependencies": {
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "liquidjs": "^10.20.1",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@fontsource/cairo": "5.3.0",
    "@fortawesome/fontawesome-free": "6.5.1",
    "clean-css": "^5.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-sonarjs": "^4.2.2"
  }
}
