---
layout: null
permalink: /ai-feed.json
sitemap: false
---
{
  "schema_version": "2.4",
  "brand": "سمسار طلبك",
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "total_count": {{ site.properties | size }},
  "last_updated": "{{ site.time | date: '%Y-%m-%d' }}",
  "properties": [
    {% for property in site.properties %}
    {%- comment -%} استخراج الرقم من نص السعر (لا يمس الحقول الأخرى) {%- endcomment -%}
    {%- assign price_num = property.priceNumeric | default: 0 -%}
    {%- if price_num == 0 and property.price -%}
      {%- assign price_clean = property.price | remove: "," | remove: "،" -%}
      {%- assign price_clean = price_clean | remove: " ج.م" | remove: " ج.م." | remove: "ج.م" -%}
      {%- assign price_clean = price_clean | remove: " جنيه" | remove: "جنيه" -%}
      {%- assign price_clean = price_clean | remove: " شهرياً" | remove: "شهرياً" -%}
      {%- assign price_clean = price_clean | remove: " شهريا" | remove: "شهريا" -%}
      {%- assign price_clean = price_clean | remove: "(قابل للتفاوض)" | remove: "قابل للتفاوض" -%}
      {%- assign price_clean = price_clean | remove: "(شامل العفش)" | remove: "شامل العفش" -%}
      {%- assign price_clean = price_clean | remove: "(سعر لقطة)" | remove: "سعر لقطة" -%}
      {%- assign price_clean = price_clean | remove: "(أو إيجار 100 ألف)" -%}
      {%- assign price_num = price_clean | plus: 0 -%}
    {%- endif -%}

    {%- comment -%} استخراج الرقم من نص المساحة (لا يمس الحقول الأخرى) {%- endcomment -%}
    {%- assign area_num = property.areaNumeric | default: 0 -%}
    {%- if area_num == 0 and property.area -%}
      {%- assign area_num = property.area | plus: 0 -%}
    {%- endif -%}

    {%- comment -%} استخراج رقم الغرف (لا يمس الحقول الأخرى) {%- endcomment -%}
    {%- assign rooms_num = property.roomsNumeric | default: 0 -%}
    {%- if rooms_num == 0 and property.rooms -%}
      {%- assign rooms_num = property.rooms | plus: 0 -%}
    {%- endif -%}

    {%- comment -%} استخراج رقم الحمامات (لا يمس الحقول الأخرى) {%- endcomment -%}
    {%- assign baths_num = property.bathsNumeric | default: 0 -%}
    {%- if baths_num == 0 -%}
      {%- assign baths_src = property.bathrooms | default: property.baths | default: "" -%}
      {%- if baths_src != "" -%}
        {%- assign baths_num = baths_src | plus: 0 -%}
      {%- endif -%}
    {%- endif -%}

    {
      "id": {{ property.id | default: property.slug | default: property.url | jsonify }},
      "title": {{ property.title | jsonify }},
      "url": {{ property.url | absolute_url | jsonify }},
      "slug": {{ property.slug | default: property.id | default: "" | jsonify }},

      "transaction": {% if property.category contains "rent" or property.title contains "إيجار" or property.title contains "ايجار" or property.title contains "للإيجار" or property.title contains "للايجار" or property.title contains "شهرياً" or property.title contains "شهريا" %}"rent"{% else %}"sale"{% endif %},

      "propertyType": {% if property.category contains "shop" or property.category contains "commercial" or property.title contains "محل" or property.title contains "تجارى" or property.title contains "تجاري" or property.title contains "معرض" or property.title contains "صيدلية" %}"shop"{% elsif property.category contains "office" or property.category contains "admin" or property.title contains "مكتب" or property.title contains "مقر" or property.title contains "إداري" or property.title contains "إدارى" %}"office"{% elsif property.category contains "villa" or property.title contains "فيلا" or property.title contains "دوبلكس" %}"villa"{% else %}"apartment"{% endif %},

      "category": {{ property.category | default: "apartments" | jsonify }},
      "location": {{ property.location | default: "" | jsonify }},
      "zone": {{ property.zone | default: property.location | default: "" | jsonify }},

      "price": {{ property.price | default: "" | jsonify }},
      "priceNumeric": {{ price_num }},

      "area": {{ property.area | default: "" | jsonify }},
      "areaNumeric": {{ area_num }},

      "rooms": {{ property.rooms | default: "" | jsonify }},
      "roomsNumeric": {{ rooms_num }},

      "baths": {{ property.bathrooms | default: property.baths | default: "" | jsonify }},
      "bathsNumeric": {{ baths_num }},

      "floor": {{ property.floor | default: "" | jsonify }},

      "finish": {{ property.finish | default: "" | jsonify }},
      "finishing": {{ property.finish | default: "" | jsonify }},

      "furnished": {% if property.title contains "غير مفروش" or property.title contains "فاضية" or property.title contains "مش مفروش" %}"فاضي (قانون جديد)"{% elsif property.furnished == true %}"مفروش"{% elsif property.title contains "مفروش" or property.description contains "مفروش" %}"مفروش"{% else %}""{% endif %},

      "description": {{ property.description | default: "" | strip_html | truncate: 200 | jsonify }},
      "image": "{{ site.url }}{{ site.baseurl }}/assets/img/properties/{{ property.image_file }}",

      "date": {{ property.date | date_to_xmlschema | jsonify }},
      "meta_title": {{ property.meta_title | default: property.title | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
