---
layout: null
permalink: /ai-feed.json
sitemap: false
---
{
  "schema_version": "2.0",
  "brand": "سمسار طلبك",
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "total_count": {{ site.properties | size }},
  "last_updated": "{{ site.time | date: '%Y-%m-%d' }}",
  "properties": [
    {% for property in site.properties %}
    {
      "id": {{ property.id | default: property.slug | default: property.url | jsonify }},
      "title": {{ property.title | jsonify }},
      "url": {{ property.url | absolute_url | jsonify }},
      "slug": {{ property.slug | default: property.id | default: "" | jsonify }},
      
      "transaction": {% if property.category == "rents" or property.category == "rent" or property.title contains "إيجار" or property.title contains "ايجار" %}"rent"{% else %}"sale"{% endif %},
      
      "propertyType": {% if property.category == "shops" or property.category == "shop" or property.title contains "محل" or property.title contains "تجارى" or property.title contains "تجاري" %}"shop"{% elsif property.category == "offices" or property.category == "office" or property.title contains "مكتب" or property.title contains "مقر" or property.title contains "إداري" or property.title contains "إدارى" %}"office"{% else %}"apartment"{% endif %},
      
      "category": {{ property.category | default: "apartments" | jsonify }},
      "location": {{ property.location | default: "" | jsonify }},
      
      "price": "{{ property.price | default: '' }}",
      "priceNumeric": {% assign p = property.price | default: "0" | remove: "," | remove: " ج.م" | remove: "ج.م" | strip %}{{ p | default: 0 }},
      
      "area": "{{ property.area | default: '' }}",
      "areaNumeric": {% assign a = property.area | default: "0" | remove: "," | remove: " م" | strip %}{{ a | default: 0 }},
      
      "rooms": "{{ property.rooms | default: '' }}",
      "baths": "{{ property.bathrooms | default: property.baths | default: '' }}",
      "floor": {{ property.floor | default: "" | jsonify }},
      "finish": {{ property.finish | default: "" | jsonify }},
      
      "furnished": {% if property.furnished == true or property.title contains "مفروش" or property.meta_description contains "مفروش" %}true{% else %}false{% endif %},
      
      "description": {{ property.meta_description | default: property.description | default: "" | strip_html | truncate: 160 | jsonify }},
      "image": "{{ site.url }}{{ site.baseurl }}/assets/img/properties/{{ property.image_file }}",
      
      "date": {{ property.date | date_to_xmlschema | jsonify }},
      "meta_title": {{ property.meta_title | default: property.title | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
