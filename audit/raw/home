<script>
  function toggleFloatingMenu(e) {
    if (e) e.stopPropagation();
    const panel = document.getElementById('floatingMenuPanel');
    const overlay = document.getElementById('floatingMenuOverlay');
    const icon = document.getElementById('floatingMenuIcon');
    
    const isOpen = panel.classList.contains('open');
    if (isOpen) {
      closeFloatingMenu();
    } else {
      panel.classList.add('open');
      overlay.classList.add('open');
      icon.className = 'fas fa-times';
    }
  }
  
  function closeFloatingMenu() {
    const panel = document.getElementById('floatingMenuPanel');
    const overlay = document.getElementById('floatingMenuOverlay');
    const icon = document.getElementById('floatingMenuIcon');
    
    panel.classList.remove('open');
    overlay.classList.remove('open');
    icon.className = 'fas fa-bars';
  }

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeFloatingMenu();
  });
</script>


