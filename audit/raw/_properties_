<script>
  (function() {
    'use strict';

    const searchInput = document.getElementById('plSearch');
    const sortSelect  = document.getElementById('plSort');
    const chips       = document.querySelectorAll('.pl-chip');
    const grid        = document.getElementById('plGrid');
    const emptyState  = document.getElementById('plEmpty');
    const countBadge  = document.getElementById('plCount');

    let currentFilter = 'all';
    let currentSearch = '';
    let currentSort   = 'newest';

    // قراءة الفلاتر من URL (لتحسين SEO / مشاركة)
    function readURLParams() {
      const params = new URLSearchParams(window.location.search);
      const type = params.get('type');
      const q = params.get('q');
      const sort = params.get('sort');

      if (type) {
        currentFilter = type;
        chips.forEach(c => {
          c.classList.toggle('active', c.dataset.filter === type);
        });
      }
      if (q) {
        currentSearch = q;
        if (searchInput) searchInput.value = q;
      }
      if (sort) {
        currentSort = sort;
        if (sortSelect) sortSelect.value = sort;
      }
    }

    // تحديث URL بدون إعادة تحميل
    function updateURL() {
      const params = new URLSearchParams();
      if (currentFilter !== 'all') params.set('type', currentFilter);
      if (currentSearch) params.set('q', currentSearch);
      if (currentSort !== 'newest') params.set('sort', currentSort);

      const newURL = window.location.pathname +
                     (params.toString() ? '?' + params.toString() : '');
      window.history.replaceState({}, '', newURL);
    }

    // تطبيق الفلاتر + البحث + الترتيب
    function applyFilters() {
      const cards = Array.from(grid.querySelectorAll('.pl-card'));
      let visibleCount = 0;

      cards.forEach(card => {
        const cat   = card.dataset.category || '';
        const title = (card.dataset.title || '').toLowerCase();
        const loc   = (card.dataset.location || '').toLowerCase();

        let match = true;

        // فلتر الفئة
        if (currentFilter !== 'all') {
          if (currentFilter === 'apartment') {
            match = match && (cat === 'apartment' || cat === 'villa');
          } else {
            match = match && (cat === currentFilter);
          }
        }

        // البحث
        if (match && currentSearch) {
          const q = currentSearch.toLowerCase();
          match = title.includes(q) || loc.includes(q);
        }

        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      // الترتيب
      const visibleCards = cards.filter(c => c.style.display !== 'none');
      sortCards(visibleCards);

      // إعادة ترتيب في DOM
      visibleCards.forEach(card => grid.appendChild(card));

      // حالة فارغة
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';

      // عدّاد النتائج
      if (countBadge) {
        countBadge.textContent = visibleCount + ' عقار';
      }
    }

    // ترتيب البطاقات
    function sortCards(cards) {
      cards.sort((a, b) => {
        switch (currentSort) {
          case 'price-asc':
            return (parseInt(a.dataset.price) || 0) - (parseInt(b.dataset.price) || 0);
          case 'price-desc':
            return (parseInt(b.dataset.price) || 0) - (parseInt(a.dataset.price) || 0);
          case 'area-desc':
            return (parseInt(b.dataset.area) || 0) - (parseInt(a.dataset.area) || 0);
          case 'rooms-desc':
            return (parseInt(b.dataset.rooms) || 0) - (parseInt(a.dataset.rooms) || 0);
          case 'newest':
          default:
            return (parseInt(b.dataset.date) || 0) - (parseInt(a.dataset.date) || 0);
        }
      });
    }

    // ═══ Event Listeners ═══

    // بحث (debounce)
    let searchTimer;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          currentSearch = e.target.value.trim();
          updateURL();
          applyFilters();
        }, 250);
      });
    }

    // ترتيب
    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => {
        currentSort = e.target.value;
        updateURL();
        applyFilters();
      });
    }

    // فلاتر
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentFilter = chip.dataset.filter;
        updateURL();
        applyFilters();
      });
    });

    // ═══ Init ═══
    readURLParams();
    applyFilters();
  })();
</script>
</main>

