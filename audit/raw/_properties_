<script>
  (function() {
    const footer = document.getElementById('siteFooter');
    const miniBar = footer ? footer.querySelector('.footer-mini-bar') : null;
    const STORAGE_KEY = 'siteFooterState';

    if (!footer || !miniBar) return;

    // استرجاع الحالة من sessionStorage
    let isExpanded = false;
    try {
      isExpanded = sessionStorage.getItem(STORAGE_KEY) === 'expanded';
    } catch (e) { /* ignore */ }

    // تطبيق الحالة الأولية
    if (isExpanded) {
      footer.classList.add('expanded');
      miniBar.setAttribute('aria-expanded', 'true');
    }

    // دالة التبديل
    window.toggleFooter = function() {
      const nowExpanded = footer.classList.toggle('expanded');
      miniBar.setAttribute('aria-expanded', nowExpanded ? 'true' : 'false');

      // حفظ الحالة
      try {
        sessionStorage.setItem(STORAGE_KEY, nowExpanded ? 'expanded' : 'collapsed');
      } catch (e) { /* ignore */ }
    };
  })();
</script>


